{
  "name": "markets-matcher",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "match": "tsx src/cli.ts",
    "match:loop": "tsx src/cli.ts --write --interval-minutes 10",
    "migrate": "tsx src/cli.ts --migrate-only",
    "test": "tsx tests/run-unit.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
