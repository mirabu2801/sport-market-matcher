# Either use DATABASE_URL or the POSTGRESQL_* keys below.
DATABASE_URL=
POSTGRESQL_HOST=10.10.0.50
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=
POSTGRESQL_DB=postgres
POSTGRESQL_SSL=false
POSTGRESQL_SSLMODE=disable

# Source tables. POLYMARKET_TABLE must be the table that stores the MarketInfo entity.
POLYMARKET_TABLE=markets_info
SX_MARKETS_TABLE=sx_markets

# Matcher output tables created by npm run migrate.
MARKET_MATCH_RUNS_TABLE=market_match_runs
MARKET_MATCHES_TABLE=market_matches

# Matching defaults.
MATCH_PM_LIMIT=0
MATCH_SX_LIMIT=0
MATCH_SPORT_ONLY=true
MATCH_ACTIVE_ONLY=true
MATCH_OPEN_ONLY=true
MATCH_LOOKBACK_HOURS=72
MATCH_LOOKAHEAD_HOURS=720
MATCH_MAX_TIME_DELTA_HOURS=36
MATCH_MIN_SCORE=0.78
MATCH_REVIEW_SCORE=0.66
MATCH_AMBIGUITY_GAP=0.03
